@{
    ViewData["Title"] = Localizer["page_not_found_title"];
}

<main class="govuk-main-wrapper govuk-!-padding-top-4" id="main-content" role="main">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds govuk-!-margin-top-8">
            <h1 class="govuk-heading-l">@Localizer["page_not_found_title"]</h1>
            <p class="govuk-body">@Localizer["page_not_found_typed_address"]</p>
            <p class="govuk-body">@Localizer["page_not_found_pasted_address"]</p>
            <p class="govuk-body">@Localizer["page_not_found_still_having_issues"]</p>
        </div>
    </div>
</main>
