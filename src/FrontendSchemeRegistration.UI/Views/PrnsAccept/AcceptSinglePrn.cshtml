@using FrontendSchemeRegistration.UI.Controllers.Prns
@using FrontendSchemeRegistration.UI.ViewModels.Prns
@using Microsoft.FeatureManagement
@inject IStringLocalizer<PrnDataResources> PrnDataLocalizer
@inject IFeatureManager FeatureManager
@model PrnViewModel
@{
    var multiYearObligationsEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.ShowMultiYearObligations);

    ViewData["Title"] = Localizer[(Model.IsPrn ? "prn_page_title" : "pern_page_title")];
    
    var prnHeading = string.Format(Localizer[(Model.IsPrn ? "prn_heading" : "pern_heading")].Value, Model.EffectiveAcceptanceYear);
    var prnConfirmHeading = string.Format(Localizer[(Model.IsPrn ? "prn_confirm_heading" : "pern_heading")].Value, Model.EffectiveAcceptanceYear); 
    
    var headerText = multiYearObligationsEnabled ? prnConfirmHeading : prnHeading;
    var paragraph = Localizer[multiYearObligationsEnabled ? "Confirm_Title": "Title"].Value; 
    var paragraphStyle = multiYearObligationsEnabled ? "govuk-body" : "govuk-inset-text";
}
<main class="govuk-main-wrapper govuk-!-padding-top-4" id="main-content" role="main">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">

            <form class="form" method="POST">
                @Html.HiddenFor(model => model.ExternalId)
                <h2 class="govuk-heading-l">@headerText</h2>
                <div class="@paragraphStyle">
                    @string.Format(paragraph, Model.Tonnage, PrnDataLocalizer[Model.MaterialGroup].Value.ToLower())
                </div>
                <div class="govuk-button-group">
                    @if (Model.IsStatusEditable)
                    {
                        <button class="govuk-button" type="submit" asp-action=@nameof(PrnsAcceptController.ConfirmAcceptSinglePrnPassThrough) asp-controller="PrnsAccept">
                            @Localizer["YesAcceptButton"]
                        </button>
                    }

                    @Html.ActionLink(@Localizer["NoBackButton"].Value, nameof(PrnsController.SelectSinglePrn), "Prns",
                        new
                        {
                            id = @Model.ExternalId
                        },
                        new
                        {
                            @class = "govuk-button govuk-button--secondary"
                        })
                </div>
            </form>
        </div>
    </div>
</main>