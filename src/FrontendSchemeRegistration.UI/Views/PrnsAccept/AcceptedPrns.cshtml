@using FrontendSchemeRegistration.UI.Controllers.Prns
@using FrontendSchemeRegistration.UI.ViewModels.Prns
@using Microsoft.FeatureManagement
@inject IStringLocalizer<PrnDataResources> PrnDataLocalizer
@inject IFeatureManager FeatureManager
@model AcceptedPrnsModel
@{
    ViewData["Title"] = Localizer["page_title"];
    var multiYearEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.ShowMultiYearObligations);
    var summaryText = Model.BuildConfirmationHeading(
        multiYearEnabled,
        key => Localizer[key].Value,
        noteType => PrnDataLocalizer[noteType].Value);

    var obligationsButtonClass = multiYearEnabled
        ? "govuk-button govuk-button--secondary"
        : "govuk-button govuk-button--primary";
    var pageColumnClass = multiYearEnabled
        ? "govuk-grid-column-full"
        : "govuk-grid-column-two-thirds";

    void RenderMaterialCard(AcceptedDetails detail)
    {
        <div class="card govuk-card--blue govuk-!-margin-bottom-5">
            <div class="govuk-card-body">
                @if (!multiYearEnabled)
                {
                    <h2 class="govuk-heading-s govuk-!-margin-bottom-3 govuk-card-body-text--white">@PrnDataLocalizer[detail.Material]</h2>
                }
                <h2 class="govuk-heading-xl govuk-!-margin-bottom-3 govuk-card-body-text--white">@Localizer["number_tonnes", detail.Tonnage]</h2>
                <p class="govuk-body govuk-!-margin-bottom-3 govuk-card-body-text--white">
                    @(multiYearEnabled
                        ? Localizer["accepted_towards_your_material_obligation_multi_year", PrnDataLocalizer[detail.Material].Value.ToLower()]
                        : Localizer["credited_towards_your_material_obligation", PrnDataLocalizer[detail.Material].Value])
                </p>
            </div>
        </div>
    }
}

<main class="govuk-main-wrapper govuk-!-padding-top-4" aria-label="main" id="main-content" role="main">

    <div class="govuk-grid-row">
        <div class="@pageColumnClass">
            <main class="govuk-main-wrapper govuk-main-wrapper--l" aria-label="confirmation" id="main-content-confirmation" role="main">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-full">
                        <div class="govuk-panel govuk-panel--confirmation">
                            <h1 class="govuk-panel__title">
                                @summaryText
                            </h1>
                        </div>
                    </div>
                </div>
            </main>

            @if (!multiYearEnabled)
            {
                <h2 class="govuk-heading-m">@Localizer["what_happens_next"]</h2>
                <p class="govuk-body">
                    @Localizer[Model.Count == 1 ? "we_will_credit_this_towards_your_yyyy_recycling obligations" : "we_will_credit_these_towards_your_yyyy_recycling obligations", Model.ObligationYears]
                </p>
            }
            @for (int i = 0; i < Model.Details.Count; i++)
            {
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-half">
                        @{ RenderMaterialCard(Model.Details[i]); }
                    </div>
                    @if (i + 1 < Model.Details.Count)
                    {
                        i++;
                        <div class="govuk-grid-column-one-half">
                            @{ RenderMaterialCard(Model.Details[i]); }
                        </div>
                    }
                </div>
            }

            <p class="govuk-body">
                @Localizer["download_prns_and_perns_from_search_page_part_1"]
                <a href="view-awaiting-acceptance" class="govuk-link">@Localizer["download_prns_and_perns_from_search_page_part_2"]</a>
                @Localizer["download_prns_and_perns_from_search_page_part_3"]
            </p>
            
            <div class="govuk-button-group">

                @Html.ActionLink(Localizer["view_recycling_obligations_progress"].Value, nameof(PrnsObligationController.ObligationsHome), "PrnsObligation",
                         null,
                         new
                         {
                             @class = obligationsButtonClass
                         })
            </div>

        </div>
    </div>
</main>
