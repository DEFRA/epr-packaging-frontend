@using FrontendSchemeRegistration.UI.Controllers.Prns
@using FrontendSchemeRegistration.UI.ViewModels.Prns
@using FrontendSchemeRegistration.UI.ViewModels.Shared
@model ChooseAcceptanceYearViewModel

@{
    ViewData["Title"] = Localizer[(Model.IsPrn ? "page_title_prn" : "page_title_pern")];
    var errorsViewModel = new ErrorsViewModel(ViewData.ModelState.ToErrorDictionary(), Localizer, nameof(Model.SelectedYear));
}

<main class="govuk-main-wrapper govuk-!-padding-top-4" id="main-content" role="main">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @if (!ViewData.ModelState.IsValid)
            {
                @await Html.PartialAsync("Partials/Govuk/_ErrorsViewModelSummary", errorsViewModel)
            }

            <form asp-controller="PrnsAccept" asp-action="@nameof(PrnsAcceptController.ChooseAcceptanceYear)" asp-route-id="@Model.ExternalId" method="post" class="form">
                @Html.HiddenFor(model => model.ExternalId)
                @Html.HiddenFor(model => model.IsPrn)

                <div class="govuk-form-group@(!ViewData.ModelState.IsValid ? " govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">
                                @Localizer[(Model.IsPrn ? "heading_prn" : "heading_pern")]
                            </h1>
                        </legend>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            @await Html.PartialAsync("Partials/Govuk/_ErrorsViewModelError", errorsViewModel[nameof(Model.SelectedYear)])
                        }

                        <div class="govuk-radios govuk-radios--inline" data-module="govuk-radios">
                            @foreach (var year in Model.AvailableAcceptanceYears)
                            {
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input"
                                           id="SelectedYear-@year"
                                           name="@nameof(Model.SelectedYear)"
                                           type="radio"
                                           value="@year"
                                           @(Model.SelectedYear == year ? "checked" : null) />
                                    <label class="govuk-label govuk-radios__label" for="SelectedYear-@year">
                                        @year
                                    </label>
                                </div>
                            }
                        </div>
                    </fieldset>
                </div>

                <button class="govuk-button" data-module="govuk-button" type="submit">
                    @SharedLocalizer["continue"]
                </button>
            </form>
        </div>
    </div>
</main>
